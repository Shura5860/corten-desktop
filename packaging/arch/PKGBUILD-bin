# Maintainer: Corten Desktop Contributors <https://github.com/Shura5860/corten-desktop>
pkgname=corten-desktop-bin
pkgver=0.5.9
pkgrel=1
pkgdesc="Pure-Rust Wayland desktop environment powered by Smithay, Iced & AURA-CORE (precompiled binary release)"
arch=('x86_64')
url="https://github.com/Shura5860/corten-desktop"
license=('GPL-3.0-or-later' 'MIT')
depends=(
    'wayland'
    'libxkbcommon'
    'libinput'
    'mesa'
    'libdrm'
    'seatd'
    'pam'
    'pipewire'
    'wireplumber'
    'polkit'
    'xdg-desktop-portal'
    'wl-clipboard'
    'cliphist'
    'grim'
    'noto-fonts'
    'noto-fonts-emoji'
    'ttf-dejavu'
    'hicolor-icon-theme'
    'adwaita-cursors'
    'flatpak'
)
optdepends=(
    'greetd: Display manager for Corten Greeter login screen (run: sudo corten-enable-greeter)'
    'cage: Wayland kiosk compositor for Corten Greeter'
    'flatpak: Install Flathub applications directly from Corten Forge'
    'xorg-xwayland: X11 application compatibility via XWayland'
    'networkmanager: Wi-Fi, VPN & Hotspot management in Corten Panel/Settings'
)
provides=('corten-desktop')
conflicts=('corten-desktop' 'corten-desktop-git')
source=("${url}/releases/download/v${pkgver}/corten-desktop-v${pkgver}-x86_64-linux.tar.gz")
sha256sums=('SKIP')

package() {
    local root="${srcdir}/corten-desktop-v${pkgver}-x86_64-linux"
    if [ -d "${root}/bin" ]; then
        cd "${root}"
    else
        cd "${srcdir}"
    fi

    install -dm755 "${pkgdir}/usr/bin"
    local bindir="."
    if [ -d "bin" ]; then
        bindir="bin"
    fi

    for bin in "${bindir}"/corten-*; do
        if [ -f "${bin}" ] && [ -x "${bin}" ]; then
            install -Dm755 "${bin}" "${pkgdir}/usr/bin/$(basename "${bin}")"
        fi
    done
    if [ -f "${bindir}/cortenctl" ]; then
        install -Dm755 "${bindir}/cortenctl" "${pkgdir}/usr/bin/cortenctl"
    fi
    if [ ! -f "${pkgdir}/usr/bin/corten-terminal" ]; then
        cat > "${pkgdir}/usr/bin/corten-terminal" << 'EOF'
#!/usr/bin/env sh
if command -v foot >/dev/null 2>&1; then exec foot --app-id=corten-terminal "$@";
elif command -v alacritty >/dev/null 2>&1; then exec alacritty --class corten-terminal,corten-terminal "$@";
elif command -v kitty >/dev/null 2>&1; then exec kitty --class corten-terminal "$@";
elif command -v wezterm >/dev/null 2>&1; then exec wezterm start --class corten-terminal "$@";
elif command -v ghostty >/dev/null 2>&1; then exec ghostty --class=corten-terminal "$@";
else exec xterm "$@"; fi
EOF
        chmod 755 "${pkgdir}/usr/bin/corten-terminal"
    fi

    if [ -f "scripts/corten-enable-greeter" ]; then
        install -Dm755 "scripts/corten-enable-greeter" "${pkgdir}/usr/bin/corten-enable-greeter"
    fi
    if [ -f "corten-portal/corten.portal" ]; then
        install -Dm644 "corten-portal/corten.portal" \
            "${pkgdir}/usr/share/xdg-desktop-portal/portals/corten.portal"
    fi
    if [ -f "corten-portal/corten-portals.conf" ]; then
        install -Dm644 "corten-portal/corten-portals.conf" \
            "${pkgdir}/usr/share/xdg-desktop-portal/corten-portals.conf"
    fi
    if [ -d "assets/wallpapers" ]; then
        install -dm755 "${pkgdir}/usr/share/backgrounds/corten"
        cp -r assets/wallpapers/* "${pkgdir}/usr/share/backgrounds/corten/"
    fi
    if [ -d "assets/icons/hicolor" ]; then
        install -dm755 "${pkgdir}/usr/share/icons/hicolor"
        cp -r assets/icons/hicolor/* "${pkgdir}/usr/share/icons/hicolor/"
    fi
    if [ -d "assets/applications" ]; then
        install -dm755 "${pkgdir}/usr/share/applications"
        for desk in assets/applications/*.desktop; do
            if [ -f "${desk}" ]; then
                install -Dm644 "${desk}" "${pkgdir}/usr/share/applications/$(basename "${desk}")"
            fi
        done
    fi
    if [ -d "systemd" ]; then
        for unit in systemd/*.service systemd/*.target; do
            if [ -f "${unit}" ]; then
                install -Dm644 "${unit}" "${pkgdir}/usr/lib/systemd/user/$(basename "${unit}")"
            fi
        done
    fi

    install -dm755 "${pkgdir}/usr/share/wayland-sessions"
    cat > "${pkgdir}/usr/share/wayland-sessions/corten.desktop" << 'EOF'
[Desktop Entry]
Name=Corten Desktop
Comment=Pure-Rust Wayland Desktop Environment
Exec=/usr/bin/corten-session
Type=Application
DesktopNames=corten
EOF
    install -dm755 "${pkgdir}/etc/pam.d"
    printf '#%%PAM-1.0\nauth include system-auth\n' > "${pkgdir}/etc/pam.d/corten-lock"
}
