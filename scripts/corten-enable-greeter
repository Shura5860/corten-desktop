#!/usr/bin/env bash
set -euo pipefail

# Corten Desktop Greeter Enabler (greetd + cage + corten-greeter)
# Configures /etc/greetd/config.toml and enables greetd.service automatically.

if [[ "${EUID}" -ne 0 ]]; then
    echo "Lütfen root yetkisiyle çalıştırın: sudo corten-enable-greeter"
    exit 1
fi

if ! command -v greetd >/dev/null 2>&1 || ! command -v cage >/dev/null 2>&1; then
    echo "==> greetd veya cage eksik; kuruluyor..."
    if command -v pacman >/dev/null 2>&1; then
        pacman -S --needed --noconfirm greetd cage
    elif command -v apt-get >/dev/null 2>&1; then
        apt-get update && apt-get install -y greetd cage
    elif command -v dnf >/dev/null 2>&1; then
        dnf install -y greetd cage
    else
        echo "Hata: 'greetd' ve 'cage' paketlerini dağıtımınızın paket yöneticisiyle kurun."
        exit 1
    fi
fi

GREETER_BIN="$(command -v corten-greeter || echo /usr/bin/corten-greeter)"
if [[ ! -x "${GREETER_BIN}" ]]; then
    echo "Hata: corten-greeter bulunamadı (${GREETER_BIN})."
    exit 1
fi

install -d /etc/greetd
if [[ -f /etc/greetd/config.toml ]]; then
    cp /etc/greetd/config.toml "/etc/greetd/config.toml.bak.$(date +%Y%m%d%H%M%S)"
fi

cat > /etc/greetd/config.toml << EOF
[terminal]
vt = 1

[default_session]
command = "cage -s -- ${GREETER_BIN}"
user = "greeter"
EOF

# Disable conflicting display managers if active so greetd can own VT1
for dm in gdm sddm lightdm lxdm ly; do
    if systemctl is-enabled "${dm}.service" >/dev/null 2>&1; then
        echo "==> Çakışan giriş yöneticisi devre dışı bırakılıyor: ${dm}.service"
        systemctl disable "${dm}.service" || true
    fi
done

systemctl enable greetd.service
echo "✓ Corten Greeter (greetd) başarıyla yapılandırıldı ve etkinleştirildi!"
echo "  Değişikliğin etkili olması için sistemi yeniden başlatabilirsiniz: sudo reboot"
